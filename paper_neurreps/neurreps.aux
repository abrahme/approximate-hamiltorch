\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Depth-controlled comparison. Rev-$n$ and plain-$2n$ have equal effective depth; Rev-$n$ has half the parameters. (a) Reversibility error: symmetrization restores machine precision uniformly in depth, while depth alone never does. (b) Effective sample size: the symmetrized model matches a plain model of twice the depth and four times the parameters, and matches exact HMC (dashed).}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:control}{{1}{5}{Depth-controlled comparison. Rev-$n$ and plain-$2n$ have equal effective depth; Rev-$n$ has half the parameters. (a) Reversibility error: symmetrization restores machine precision uniformly in depth, while depth alone never does. (b) Effective sample size: the symmetrized model matches a plain model of twice the depth and four times the parameters, and matches exact HMC (dashed)}{figure.1}{}}
